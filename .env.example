# Your bot's token and application ID, from the Developer Portal
DISCORD_TOKEN=
CLIENT_ID=

# Prefix for new servers (each server can change its own)
DEFAULT_PREFIX=!

# Set this to your test server's ID to register slash commands there instantly
DEV_GUILD_ID=

# Your user ID(s), comma separated, for owner-only commands
OWNER_IDS=

# Optional: your own NASA API key for the apod command
NASA_KEY=

# AI staff (mention the bot and ask in plain English). Free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: which Groq models to use. The router only picks categories, so a small model is fine there.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
# Model for reading images people attach when they talk to the AI (must support vision + tools)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Model for opt-in AI moderation (aimod)
GROQ_GUARD_MODEL=openai/gpt-oss-safeguard-20b

# Media: yt-dlp downloads itself on first use. Only set these to override that.
# YTDLP_PATH=/usr/local/bin/yt-dlp
# YTDLP_DIR=

# Storage. Defaults to data/bot.sqlite (needs Node 22.5+). An old data/db.json is imported automatically.
# Set DB_DRIVER=json to keep using the single JSON file instead.
DB_PATH=
DB_DRIVER=
